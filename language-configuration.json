{
  "comments": {
    "blockComment": ["{quote}", "{quote}"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"" }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["*", "*"],
    ["_", "_"],
    ["+", "+"],
    ["-", "-"],
    ["^", "^"],
    ["~", "~"],
    ["\"", "\""]
  ],
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([^\\`\\~\\!\\@\\#\\%\\^\\&\\*\\(\\)\\-\\=\\+\\[\\{\\]\\}\\\\\\|\\;\\:\\'\\\"\\,\\.\\<\\>\\/\\?\\s]+)",
  "onEnterRules": [
    { "beforeText": "^\\s*\\*\\*\\*\\s+\\S.*$", "action": { "indent": "none", "appendText": "*** " } },
    { "beforeText": "^\\s*\\*\\*\\s+\\S.*$", "action": { "indent": "none", "appendText": "** " } },
    { "beforeText": "^\\s*\\*\\s+\\S.*$", "action": { "indent": "none", "appendText": "* " } },
    { "beforeText": "^\\s*###\\s+\\S.*$", "action": { "indent": "none", "appendText": "### " } },
    { "beforeText": "^\\s*##\\s+\\S.*$", "action": { "indent": "none", "appendText": "## " } },
    { "beforeText": "^\\s*#\\s+\\S.*$", "action": { "indent": "none", "appendText": "# " } },
    { "beforeText": "^\\s*-\\s+\\S.*$", "action": { "indent": "none", "appendText": "- " } },
    { "beforeText": "^\\s*\\|.*\\|\\s*$", "action": { "indent": "none", "appendText": "|" } }
  ]
}
