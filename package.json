{
  "name": "jira-wiki-preview",
  "displayName": "Jira Wiki Markup — Editor & Preview",
  "description": "%extension.description%",
  "version": "0.5.1",
  "publisher": "evilfaust",
  "license": "MIT",
  "icon": "media/icons/icon.png",
  "galleryBanner": {
    "color": "#0747A6",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/evilfaust/jira-wiki-preview.git"
  },
  "homepage": "https://github.com/evilfaust/jira-wiki-preview#readme",
  "bugs": {
    "url": "https://github.com/evilfaust/jira-wiki-preview/issues"
  },
  "engines": {
    "vscode": "^1.97.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Other"
  ],
  "keywords": [
    "jira",
    "confluence",
    "wiki markup",
    "preview",
    "markdown"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onLanguage:jira"
  ],
  "contributes": {
    "languages": [
      {
        "id": "jira",
        "aliases": [
          "Jira Wiki Markup",
          "jira"
        ],
        "extensions": [
          ".jira",
          ".jira.txt",
          ".jirawiki"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./media/icons/jira-file.svg",
          "dark": "./media/icons/jira-file.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "jira",
        "scopeName": "text.jira",
        "path": "./syntaxes/jira.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "jira",
        "path": "./snippets/jira.json"
      }
    ],
    "commands": [
      {
        "command": "jira.showPreviewToSide",
        "title": "%command.showPreviewToSide.title%",
        "category": "%command.category%",
        "icon": "$(open-preview)"
      },
      {
        "command": "jira.showPreview",
        "title": "%command.showPreview.title%",
        "category": "%command.category%",
        "icon": "$(open-preview)"
      },
      {
        "command": "jira.newDocument",
        "title": "%command.newDocument.title%",
        "category": "%command.category%",
        "icon": "$(new-file)"
      },
      {
        "command": "jira.copySource",
        "title": "%command.copySource.title%",
        "category": "%command.category%"
      },
      {
        "command": "jira.toggleBold",
        "title": "%command.toggleBold.title%",
        "category": "%command.category%"
      },
      {
        "command": "jira.toggleItalic",
        "title": "%command.toggleItalic.title%",
        "category": "%command.category%"
      },
      {
        "command": "jira.toggleMonospace",
        "title": "%command.toggleMonospace.title%",
        "category": "%command.category%"
      },
      {
        "command": "jira.toggleStrikethrough",
        "title": "%command.toggleStrikethrough.title%",
        "category": "%command.category%"
      },
      {
        "command": "jira.insertLink",
        "title": "%command.insertLink.title%",
        "category": "%command.category%"
      },
      {
        "command": "jira.insertCodeBlock",
        "title": "%command.insertCodeBlock.title%",
        "category": "%command.category%"
      },
      {
        "command": "jira.insertTable",
        "title": "%command.insertTable.title%",
        "category": "%command.category%"
      },
      {
        "command": "jira.formatTable",
        "title": "%command.formatTable.title%",
        "category": "%command.category%"
      },
      {
        "command": "jira.pasteAsJira",
        "title": "%command.pasteAsJira.title%",
        "category": "%command.category%"
      },
      {
        "command": "jira.convertFromMarkdown",
        "title": "%command.convertFromMarkdown.title%",
        "category": "%command.category%"
      },
      {
        "command": "jira.convertToMarkdown",
        "title": "%command.convertToMarkdown.title%",
        "category": "%command.category%"
      },
      {
        "command": "jira.copyAsMarkdown",
        "title": "%command.copyAsMarkdown.title%",
        "category": "%command.category%"
      },
      {
        "command": "jira.useConfluenceDialect",
        "title": "%command.useConfluenceDialect.title%",
        "category": "%command.category%"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "jira.showPreviewToSide",
          "when": "editorLangId == jira && !notebookEditorFocused",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "jira.showPreviewToSide",
          "when": "editorLangId == jira",
          "group": "jira@1"
        }
      ],
      "commandPalette": [
        {
          "command": "jira.toggleBold",
          "when": "editorLangId == jira"
        },
        {
          "command": "jira.toggleItalic",
          "when": "editorLangId == jira"
        },
        {
          "command": "jira.toggleMonospace",
          "when": "editorLangId == jira"
        },
        {
          "command": "jira.toggleStrikethrough",
          "when": "editorLangId == jira"
        },
        {
          "command": "jira.insertLink",
          "when": "editorLangId == jira"
        },
        {
          "command": "jira.insertCodeBlock",
          "when": "editorLangId == jira"
        },
        {
          "command": "jira.insertTable",
          "when": "editorLangId == jira"
        },
        {
          "command": "jira.copySource",
          "when": "editorLangId == jira"
        },
        {
          "command": "jira.formatTable",
          "when": "editorLangId == jira"
        },
        {
          "command": "jira.pasteAsJira",
          "when": "editorLangId == jira"
        },
        {
          "command": "jira.convertFromMarkdown",
          "when": "editorLangId == jira"
        },
        {
          "command": "jira.convertToMarkdown",
          "when": "editorLangId == jira"
        },
        {
          "command": "jira.copyAsMarkdown",
          "when": "editorLangId == jira"
        },
        {
          "command": "jira.useConfluenceDialect",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "jira.showPreviewToSide",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorLangId == jira"
      },
      {
        "command": "jira.toggleBold",
        "key": "ctrl+b",
        "mac": "cmd+b",
        "when": "editorTextFocus && editorLangId == jira"
      },
      {
        "command": "jira.toggleItalic",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus && editorLangId == jira"
      },
      {
        "command": "jira.toggleMonospace",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m",
        "when": "editorTextFocus && editorLangId == jira"
      },
      {
        "command": "jira.insertLink",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorTextFocus && editorLangId == jira"
      },
      {
        "command": "jira.pasteAsJira",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v",
        "when": "editorTextFocus && editorLangId == jira"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "jira.markup.dialect": {
          "type": "string",
          "enum": [
            "jira",
            "confluence"
          ],
          "enumDescriptions": [
            "%configuration.markup.dialect.enum0%",
            "%configuration.markup.dialect.enum1%"
          ],
          "default": "jira",
          "description": "%configuration.markup.dialect.description%"
        },
        "jira.lint.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.lint.enabled.description%"
        },
        "jira.paste.smart": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.paste.smart.description%"
        },
        "jira.preview.theme": {
          "type": "string",
          "enum": [
            "jira",
            "editor"
          ],
          "enumDescriptions": [
            "%configuration.preview.theme.enum0%",
            "%configuration.preview.theme.enum1%"
          ],
          "default": "jira",
          "description": "%configuration.preview.theme.description%"
        },
        "jira.preview.fontSize": {
          "type": "number",
          "default": 14,
          "minimum": 8,
          "maximum": 40,
          "description": "%configuration.preview.fontSize.description%"
        },
        "jira.preview.fontFamily": {
          "type": "string",
          "default": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
          "description": "%configuration.preview.fontFamily.description%"
        },
        "jira.preview.maxWidth": {
          "type": "number",
          "default": 0,
          "description": "%configuration.preview.maxWidth.description%"
        },
        "jira.preview.scrollPreviewWithEditor": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.preview.scrollPreviewWithEditor.description%"
        },
        "jira.preview.scrollEditorWithPreview": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.preview.scrollEditorWithPreview.description%"
        },
        "jira.preview.doubleClickToSwitchToEditor": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.preview.doubleClickToSwitchToEditor.description%"
        },
        "jira.preview.highlightCode": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.preview.highlightCode.description%"
        },
        "jira.baseUrl": {
          "type": "string",
          "default": "",
          "description": "%configuration.baseUrl.description%"
        }
      }
    }
  },
  "scripts": {
    "grammar": "node scripts/gen-grammar.js",
    "icon": "node scripts/gen-icon.js",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "vsix": "npm run package && vsce package --no-dependencies",
    "release": "npm run package && vsce publish --no-dependencies",
    "release:github": "node scripts/release-github.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.97.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "highlight.js": "^11.11.1"
  }
}
