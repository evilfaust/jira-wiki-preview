      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.macro.jira"
        },
        "2": {
          "name": "support.function.macro.jira"
        },
        "3": {
          "name": "punctuation.separator.jira"
        },
        "4": {
          "name": "variable.parameter.jira"
        },
        "5": {
          "name": "variable.parameter.jira"
        },
        "6": {
          "name": "punctuation.definition.macro.jira"
        }
      },
      "end": "^\\s*(\\{)(code)(\\})\\s*$",
